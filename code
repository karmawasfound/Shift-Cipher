        newASCII = 0
        ASCII = ord(text[i])
        if k != -1:
            k = int(k)
        elif ASCII >= 97 and ASCII <= 122:
            k = abs(ord("e") - (freq.index(max(freq)) + 97))
        elif ASCII >= 65 and ASCII <= 90:
            k = abs(ord("E") - (freq.index(max(freq)) + 65))
        if text[i].isalpha() == True:
            newASCII = ASCII - k
            if (ASCII >= 97 and ASCII <= 122 and newASCII < 97) or (ASCII >= 65 and ASCII <= 90 and newASCII < 65):
                newASCII = newASCII + 26
        else:
            newASCII = ASCII
        newtext = newtext + chr(newASCII)
    freq[freq.index(max(freq))] = 0
